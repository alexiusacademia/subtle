# Where Subtle's releases go. Read by tools/gcs-setup.sh and
# tools/publish.sh. Nothing here is secret.
#
# The bucket is public to read: the website's download buttons fetch from
# it. In Tally's project, like the other Tessel apps' buckets.
#
# Author: Alexius Academia
# Date: 2026-11-23
SUBTLE_GCS_PROJECT=syncster-tally
SUBTLE_GCS_BUCKET=subtle-downloads
SUBTLE_GCS_REGION=asia-southeast1
SUBTLE_PUBLIC_BASE=https://storage.googleapis.com/subtle-downloads
# The Netlify site the website is published to.
SUBTLE_NETLIFY_SITE=
SUBTLE_SITE_URL=https://subtle.syncster.dev
